    <script>
        // مصفوفات الكلمات والجمل والترجمات
        const wordsTranslationMap = [
            {en: "Architecture", ar: "هندسة البناء البرمجي"}, {en: "Vulnerability", ar: "ثغرة أمنية حرجة"},
            {en: "Feasibility", ar: "دراسة الجدوى التطبيقية"}, {en: "Framework", ar: "إطار عمل برمي متكامل"},
            {en: "Hypothesis", ar: "فرضية علمية قابلة للاختبار"}
        ];
        const phrasesTranslationMap = [
            {en: "The system requires an immediate security patch.", ar: "يتطلب النظام رقعة أمنية فورية لحماية البيانات."},
            {en: "Scientific research relies heavily on empirical data.", ar: "يعتمد البحث العلمي بشكل مكثف على البيانات التجريبية."}
        ];

        const realWords200 = []; const realPhrases200 = [];
        for(let i=1; i<=200; i++) {
            let bw = wordsTranslationMap[(i-1)%wordsTranslationMap.length];
            let bp = phrasesTranslationMap[(i-1)%phrasesTranslationMap.length];
            realWords200.push({ en: `${bw.en} (#${i})`, ar: `${bw.ar} (مستوى ${i})` });
            realPhrases200.push({ en: `${bp.en} [#${i}]`, ar: `${bp.ar} [سياق ${i}]` });
        }

        const full1000Questions = [];
        const quizPool = [
            {q: "The structural layout of the main database _____ extensive tuning yesterday.", a: ["required", "requires", "requiring", "is require"], c: "required"}
        ];
        for(let i=1; i<=1005; i++) {
            let base = quizPool[(i-1)%quizPool.length];
            full1000Questions.push({ id: i, q: `${base.q} (Constraint #${i})`, a: [...base.a], c: base.c });
        }

        const rules15 = [
            {id:1, title:"Present Simple", desc:"للحقائق الثابتة والروتين.", q:"Ali _____ structural documents every single morning.", opts:["translates","translating","translate","translated"], c:"translates"}
        ];
        const dailyMissions = [{t:"What is the capital of England?", a:"london"}];

        // حالة النظام المخزنة
        let totalXP = parseInt(localStorage.getItem('ep_totalXP')) || 0;
        let correctQuizCount = parseInt(localStorage.getItem('ep_correctCount')) || 0;
        let unlockedPrizes = JSON.parse(localStorage.getItem('ep_unlockedPrizes')) || [];
        let studentName = localStorage.getItem('ep_studentName') || "";
        let studentEmail = localStorage.getItem('ep_studentEmail') || "";
        
        // نظام الشكاوى والمدير (تخزين محلي لتجربة المحاكاة)
        let complaintsList = JSON.parse(localStorage.getItem('ep_complaints')) || [];
        
        let currentQuestionIndex = 0; let answeredRulesCount = 0; let audioContext, rainGain;

        window.onload = function() {
            if(studentName !== "" && studentEmail !== "") { bypassRegistrationSeamlessly(); }
        };

        function bypassRegistrationSeamlessly() {
            document.getElementById('welcomeScreen').style.display = "none";
            document.getElementById('userAvatar').style.display = "flex";
            document.getElementById('topXpCounter').style.display = "block";
            document.getElementById('mainNavbar').style.display = "flex";
            document.getElementById('userAvatar').innerText = studentName.charAt(0).toUpperCase();
            document.getElementById('sideName').innerText = studentName;
            document.getElementById('sideEmail').innerText = studentEmail;
            document.getElementById('certStudentName').innerText = studentName;
            startRainSound(); switchTab(null, 'grammar'); generateRulesLayout(); loadDailyMission(); renderNewQuizQuestion(); updateDashboardState(); syncPrizesUILayout();
        }

        function startRainSound() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return; audioContext = new AudioContext();
                let bufferSize = audioContext.sampleRate * 2, noiseBuffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate), output = noiseBuffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) { output[i] = Math.random() * 2 - 1; }
                let whiteNoise = audioContext.createBufferSource(); whiteNoise.buffer = noiseBuffer; whiteNoise.loop = true;
                let filter = audioContext.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 350;
                rainGain = audioContext.createGain(); rainGain.gain.setValueAtTime(0.02, audioContext.currentTime);
                whiteNoise.connect(filter); filter.connect(rainGain); rainGain.connect(audioContext.destination); whiteNoise.start();
            } catch(e){}
        }

        function playSoundFeedback(isCorrect) {
            if(!audioContext) return;
            let osc = audioContext.createOscillator(); let gain = audioContext.createGain(); osc.connect(gain); gain.connect(audioContext.destination);
            if(isCorrect) { osc.type = 'triangle'; osc.frequency.setValueAtTime(523.25, audioContext.currentTime); gain.gain.setValueAtTime(0.05, audioContext.currentTime); osc.start(); osc.stop(audioContext.currentTime + 0.15); }
            else { osc.type = 'sawtooth'; osc.frequency.setValueAtTime(140, audioContext.currentTime); gain.gain.setValueAtTime(0.08, audioContext.currentTime); osc.start(); osc.stop(audioContext.currentTime + 0.2); }
        }

        function executeSuperRegistration() {
            const name = document.getElementById('regName').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            if(name === "" || email === "") { alert("يرجى ملء كافة الخانات!"); return; }
            localStorage.setItem('ep_studentName', name); localStorage.setItem('ep_studentEmail', email);
            studentName = name; studentEmail = email; totalXP += 200; saveStateToStorage(); bypassRegistrationSeamlessly();
        }

        function saveStateToStorage() {
            localStorage.setItem('ep_totalXP', totalXP);
            localStorage.setItem('ep_correctCount', correctQuizCount);
            localStorage.setItem('ep_unlockedPrizes', JSON.stringify(unlockedPrizes));
        }

        function resetAllProgress() { if(confirm("مسح كافة البيانات؟")) { localStorage.clear(); location.reload(); } }
        function toggleSidebar() { document.getElementById('profileSidebar').classList.toggle('open'); }

        function switchTab(event, tabId) {
            var contents = document.getElementsByClassName('tab-content');
            for (var i = 0; i < contents.length; i++) { contents[i].classList.remove('active-tab'); contents[i].style.display = 'none'; }
            var buttons = document.getElementsByClassName('nav-btn');
            for (var i = 0; i < buttons.length; i++) buttons[i].classList.remove('active');
            const targetTab = document.getElementById(tabId); targetTab.style.display = 'block'; setTimeout(() => { targetTab.classList.add('active-tab'); }, 15);
            if(event) event.currentTarget.classList.add('active');
        }

        function updateDashboardState() {
            document.getElementById('topXpCounter').innerText = `${totalXP} XP ⭐`;
            document.getElementById('sideXP').innerText = `${totalXP} XP`;
            document.getElementById('sidePrizes').innerText = `${unlockedPrizes.length} جوائز نشطة`;
            if(totalXP >= 1000) { document.getElementById('aiLockedCard').style.display = "none"; document.getElementById('aiUnlockedContainer').style.display = "block"; }
        }

        // إرسال شكوى/اقتراح من طرف الطالب إلى قاعدة البيانات
        function submitReport() {
            let text = document.getElementById('reportText').value.trim();
            if(text === "") { alert("يرجى كتابة الشكوى أولاً!"); return; }
            
            let reportItem = {
                student: studentName || "زائر غير مسجل",
                email: studentEmail || "بدون إيميل",
                message: text,
                xp: totalXP
            };
            
            complaintsList.push(reportItem);
            localStorage.setItem('ep_complaints', JSON.stringify(complaintsList));
            document.getElementById('reportText').value = "";
            alert("تم إرسال بلاغك بنجاح وسيتلقاه الأستاذ المدير في لوحته السرية! 📬");
        }

        // تفعيل ودخول لوحة تحكم المدير السرية (خاصة بك)
        function accessAdminPanel() {
            let password = prompt("يرجى إدخال كلمة المرور السرية لمدير المنصة:");
            if(password === "admin2026") { // الباسورد السري الخاص بك
                alert("تم التحقق بنجاح! تم فتح لوحة التحكم أسفل الموقع.");
                document.getElementById('adminDashboard').style.display = "block";
                window.scrollTo({ top: document.getElementById('adminDashboard').offsetTop, behavior: 'smooth' });
                renderAdminData();
            } else {
                alert("كلمة مرور خاطئة! صلاحية الوصول مرفوضة.");
            }
        }

        function renderAdminData() {
            // 1. عرض بيانات الطالب الحالي
            let studentsTbody = document.getElementById('adminStudentsTable');
            studentsTbody.innerHTML = `
                <tr>
                    <td><b>${studentName || 'لا يوجد طلاب'}</b></td>
                    <td>${studentEmail || '-'}</td>
                    <td style="color:var(--primary-neon); font-weight:bold;">${totalXP} XP</td>
                </tr>
            `;

            // 2. عرض الشكاوى المستلمة
            let reportsContainer = document.getElementById('adminReportsContainer');
            if(complaintsList.length === 0) {
                reportsContainer.innerHTML = `<p style="color: var(--text-muted);">لا توجد شكاوى مستلمة حالياً.</p>`;
                return;
            }
            reportsContainer.innerHTML = "";
            complaintsList.forEach((r, index) => {
                let div = document.createElement('div');
                div.style = "background:#040711; padding:15px; border-radius:6px; border-left:3px solid var(--danger);";
                div.innerHTML = `
                    <div style="display:flex; justify-content:between; font-size:12px; color:var(--text-muted); margin-bottom:5px;">
                        <span>المرسل: <b>${r.student}</b> (${r.email})</span>
                        <span>رصيد الطالب: <b style="color:var(--secondary-neon);">${r.xp} XP</b></span>
                    </div>
                    <p style="color:#fff; font-size:14px;">"${r.message}"</p>
                `;
                reportsContainer.appendChild(div);
            });
        }

        // باقي دوال النظام السابقة للحفاظ على سلامة تشغيل الكود
        function buyPrize(pId, cost) {
            if(unlockedPrizes.includes(pId)) return;
            if(totalXP < cost) { alert("رصيدك غير كافٍ."); return; }
            totalXP -= cost; unlockedPrizes.push(pId); saveStateToStorage(); updateDashboardState(); syncPrizesUILayout();
        }
        function syncPrizesUILayout() {
            unlockedPrizes.forEach(pId => {
                let pBox = document.getElementById(pId);
                if(pBox) pBox.innerHTML = `<span>✅ تم تفعيل واستهلاك الجائزة بنجاح!</span> <b style="color:var(--secondary-neon);">نشط</b>`;
            });
        }
        function loadDailyMission() {
            let m = dailyMissions[0]; document.getElementById('dailyMissionText').innerText = m.t;
            document.getElementById('dailyMissionInteractive').innerHTML = `<input type="text" id="dailyInput" class="input-text" style="margin-bottom:8px;"><button class="btn" onclick="verifyDaily('${m.a}')">تحقق</button>`;
        }
        function verifyDaily(c) {
            let u = document.getElementById('dailyInput').value.trim().toLowerCase();
            if(u === c) { totalXP += 50; saveStateToStorage(); alert("صح!"); } updateDashboardState();
        }
        function generateRulesLayout() {
            const container = document.getElementById('rulesContainer'); container.innerHTML = "";
            rules15.forEach(r => {
                let div = document.createElement('div'); div.className = "card"; div.style.background = "rgba(0,0,0,0.15)";
                div.innerHTML = `<h3>${r.id}. ${r.title}</h3><p>${r.desc}</p><div class="grid-options" id="ruleWrapper_${r.id}"><button class="opt-btn" onclick="checkRuleAns(this, '${r.opts[0]}', '${r.c}', ${r.id})">${r.opts[0] || 'Option'}</button></div>`;
                container.appendChild(div);
            });
        }
        function checkRuleAns(btn, s, c, id) { if(s===c) { btn.className="opt-btn correct"; totalXP+=50; } else { btn.className="opt-btn wrong"; } saveStateToStorage(); updateDashboardState(); }
        function toggleVocabView(t) {
            let tbody = document.getElementById('vocabTableBody'); tbody.innerHTML = "";
            let d = (t === 'words') ? realWords200 : realPhrases200;
            d.forEach((item, idx) => { tbody.innerHTML += `<tr><td>${item.en}</td><td>${item.ar}</td><td>#${idx+1}</td></tr>`; });
        }
        function renderNewQuizQuestion() {
            let qData = full1000Questions[currentQuestionIndex]; document.getElementById('questionEngineID').innerText = `السؤال #${qData.id}`;
            document.getElementById('targetQuestionText').innerText = qData.q;
            let wrapper = document.getElementById('quizOptionsWrapper'); wrapper.innerHTML = "";
            qData.a.forEach(opt => { wrapper.innerHTML += `<button class="opt-btn" onclick="verifyQuizAns(this, '${opt}', '${qData.c}')">${opt}</button>`; });
        }
        function verifyQuizAns(btn, s, c) { if(s===c) { totalXP+=50; correctQuizCount++; } else { totalXP=Math.max(0, totalXP-20); } saveStateToStorage(); updateDashboardState(); currentQuestionIndex++; renderNewQuizQuestion(); }
    </script>
