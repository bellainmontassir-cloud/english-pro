<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🇬🇧 منصة english pro - الإصدار V8.5 الإداري</title>
    <style>
        :root {
            --bg-dark: #040711;
            --card-bg: #090f1d;
            --primary-neon: #06b6d4;
            --secondary-neon: #10b981;
            --accent-orange: #f97316;
            --text-light: #f8fafc;
            --text-muted: #64748b;
            --success: #10b981;
            --danger: #ef4444;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg-dark); color: var(--text-light); overflow-x: hidden; }

        header {
            background: linear-gradient(135deg, #1e3a8a, #020617);
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--primary-neon);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.15);
        }

        header h1 { font-size: 24px; color: #fff; text-shadow: 0 0 8px var(--primary-neon); }
        
        .header-controls { display: flex; align-items: center; gap: 15px; }
        .xp-top-counter { background: rgba(6, 182, 212, 0.1); border: 1px solid var(--primary-neon); padding: 6px 15px; border-radius: 20px; color: var(--primary-neon); font-weight: bold; font-size: 14px; text-shadow: 0 0 5px var(--primary-neon); }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, var(--primary-neon), var(--secondary-neon));
            color: #040711;
            font-size: 18px;
            font-weight: bold;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 0 12px var(--primary-neon);
            transition: transform 0.3s;
        }

        .profile-sidebar {
            position: fixed;
            top: 0; right: -320px;
            width: 300px; height: 100%;
            background: #0b1528;
            box-shadow: -5px 0 30px rgba(0,0,0,0.7);
            z-index: 1000;
            padding: 30px 20px;
            transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-left: 2px solid var(--primary-neon);
        }
        .profile-sidebar.open { right: 0; }
        .close-sidebar { background: none; border: none; color: var(--danger); font-size: 20px; cursor: pointer; float: left; }

        nav { background-color: var(--card-bg); display: none; justify-content: center; flex-wrap: wrap; border-bottom: 1px solid rgba(255,255,255,0.05); }
        nav button { background: none; border: none; color: #64748b; padding: 15px 18px; font-size: 14px; font-weight: bold; cursor: pointer; transition: all 0.3s ease; }
        nav button:hover, nav button.active { color: #fff; background-color: rgba(6, 182, 212, 0.05); border-bottom: 3px solid var(--primary-neon); }

        .container { max-width: 1050px; margin: 25px auto; padding: 0 20px; }
        
        .tab-content { display: none; opacity: 0; transform: translateY(25px) scale(0.98); transition: all 0.4s ease-out; }
        .tab-content.active-tab { display: block; opacity: 1; transform: translateY(0) scale(1); }

        .card { background-color: var(--card-bg); border-radius: 12px; border: 1px solid rgba(255,255,255,0.02); padding: 25px; margin-bottom: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.3); }
        .card h2 { color: #fff; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 10px; font-size: 20px; }

        .input-group { margin-bottom: 15px; text-align: right; }
        .input-group label { display: block; margin-bottom: 5px; font-size: 14px; color: #94a3b8; }
        .input-text { background-color: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 12px; border-radius: 6px; font-size: 15px; width: 100%; transition: 0.2s; }
        .input-text:focus { border-color: var(--primary-neon); outline: none; }

        .btn { background: linear-gradient(90deg, var(--primary-neon), var(--secondary-neon)); color: #050811; font-weight: bold; padding: 11px 22px; border: none; border-radius: 6px; cursor: pointer; transition: 0.2s; }
        .btn:hover { filter: brightness(1.2); transform: translateY(-1px); }

        .grid-options { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 15px 0; }
        .opt-btn { background: #131c2e; border: 1px solid rgba(255,255,255,0.08); color: #fff; padding: 12px; border-radius: 6px; cursor: pointer; font-size: 14px; text-align: left; transition: 0.2s; }
        .opt-btn:hover:not(:disabled) { border-color: var(--primary-neon); background: rgba(6, 182, 212, 0.05); }

        .correct { border-color: var(--success) !important; background: rgba(16, 185, 129, 0.1) !important; color: #34d399 !important; }
        .wrong { border-color: var(--danger) !important; background: rgba(239, 68, 68, 0.1) !important; color: #f87171 !important; }

        .table-wrapper { max-height: 400px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; }
        table { width: 100%; border-collapse: collapse; text-align: center; font-size: 14px; }
        th, td { padding: 11px; border-bottom: 1px solid rgba(255,255,255,0.03); }
        th { background: #111827; color: #fff; position: sticky; top: 0; z-index: 10; }

        .chat-box { background: #020617; border-radius: 8px; height: 260px; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 12px; }
        .msg { max-width: 80%; padding: 10px 14px; border-radius: 8px; font-size: 14px; }
        .msg.ai { background: rgba(6, 182, 212, 0.08); align-self: flex-start; border-left: 3px solid var(--primary-neon); text-align: left; direction: ltr; }
        .msg.user { background: rgba(16, 185, 129, 0.08); align-self: flex-end; border-right: 3px solid var(--secondary-neon); text-align: left; direction: ltr; }

        .prize-box { background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.3); padding: 12px; border-radius: 8px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .prize-box.unlocked { border-color: var(--secondary-neon); background: rgba(16, 185, 129, 0.08); }

        footer { text-align: center; padding: 25px; background: #02040a; color: #475569; font-size: 13px; margin-top: 30px; border-top: 1px solid rgba(255,255,255,0.02); }
        
        /* تصميم لوحة تحكم المدير السرية */
        #adminDashboard { display: none; background: #0b1329; border: 2px dashed var(--primary-neon); padding: 25px; border-radius: 12px; margin-top: 30px; }
    </style>
</head>
